# Compose reads these for ${VAR} substitution (local: project .env; Coolify: UI env vars).
# Do not rely on env_file — Coolify injects vars from the dashboard.

# Infrastructure
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<postgres_password>
POSTGRES_DB=location_guessing_game
REDIS_PASSWORD=<redis_password>
DRIZZLE_GATEWAY_PASSWORD=<drizzle_gateway_password>

# Host-only DB/Redis URLs (bot outside Docker). Compose builds these for the app service.
# DATABASE_URL=postgres://postgres:<postgres_password>@localhost:5432/location_guessing_game
# REDIS_URL=redis://:<redis_password>@localhost:6379

# Discord bot
DISCORD_TOKEN=<discord_bot_token>
DISCORD_CLIENT_ID=<discord_application_client_id>
DISCORD_GUILD_ID=<discord_guild_id>
DISCORD_ADMIN_USER_ID=<discord_user_id>
DISCORD_GAME_CHANNEL_ID=<discord_channel_id>
DISCORD_LOG_CHANNEL_ID=<optional_log_channel_id>

# Nominatim / locale
NOMINATIM_USER_AGENT=location-guessing-game/0.1 contact@example.com
NOMINATIM_EMAIL=contact@example.com
BOT_LOCALE=en
