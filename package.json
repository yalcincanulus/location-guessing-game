{
  "name": "location-guessing-game",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "start": "bun run index.ts --watch",
    "build:compile": "bun build --compile --outfile location-game ./index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "test": "bun test",
    "sim:achievements": "bun run scripts/achievements/run-sims.ts",
    "sim:achievements:keep": "bun run scripts/achievements/run-sims.ts --keep",
    "sim:achievements:cleanup": "bun run scripts/achievements/run-cleanup.ts",
    "sim:achievements:existing": "bun run scripts/achievements/report-existing.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "check": "bun run typecheck && bun run test && bun run lint && bun run format"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.7",
    "bullmq": "^6.2.0",
    "d3-geo": "^3.1.1",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/bun": "latest",
    "@types/d3-geo": "^3.1.1",
    "@types/topojson-client": "^3.1.5",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
